# Copy to .env and fill in values. .env is gitignored.
#
# Cloudflare R2 (for highlight clip uploads)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=stompers-videos
R2_PUBLIC_BASE=https://pub-27636b574e544724ab8c5d7c7e755a99.r2.dev

# Firestore (service-account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/stompers-tracker-firebase-adminsdk.json
FIRESTORE_PROJECT_ID=stompers-tracker

# Behind a TLS-intercepting corporate proxy: point boto3 at a bundle that
# includes the corp root, or R2 uploads fail CERTIFICATE_VERIFY_FAILED.
# Regenerate with:
#   security find-certificate -a -p /Library/Keychains/System.keychain >> corp_ca.pem
#   security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain >> corp_ca.pem
AWS_CA_BUNDLE=/absolute/path/to/corp_ca.pem

# Same proxy, different symptom: its leaf certs carry no Authority Key
# Identifier, which OpenSSL 3 / Python 3.13 reject even with the root trusted
# (curl accepts the identical chain, so it reads as a network fault). The VLM
# stage is wrapped in a non-fatal try/except, so the run reports SUCCESS having
# written zero jersey-number drafts. Setting this clears ONLY the X509_STRICT
# flag — chain and hostname are still verified. Do NOT use VLM_INSECURE_TLS=1
# instead; that accepts any certificate.
VLM_RELAXED_TLS=1

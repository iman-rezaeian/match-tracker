rules_version = '2';

// Firestore security rules for the Stompers match tracker.
//
// PRIVACY MODEL
// ─────────────
// Public (parents/spectators, unauthenticated or anonymous):
//   - can READ the games collection (scoreboard, events, goals)
//   - CAN read the public broadcast fields on each game doc
//     (videoHighlightsUrl, videoFullGameUrl, …) and games/<id>/public/broadcast
//   - CANNOT read the team doc — it holds the ROSTER, which carries every
//     child's full name and photo_url. Public pages get their player names
//     from the first-name-only fields in the broadcast index instead.
//   - CANNOT read the analytics/ subcollection or the clips/ subcollection
//     under games (which contain per-player stats, GK positioning,
//     identity confidence, sample-rate-level tracks, etc.)
//   - CANNOT write anything.
//
// Coach (authenticated user whose email appears in /allowedUsers
// with role == "coach"):
//   - can READ everything under teams/main
//   - can WRITE everything under teams/main
//
// Pipeline service account (Firebase Admin SDK / google-cloud-firestore
// with default service-account credentials) bypasses these rules entirely.
// No rule needs to allow it explicitly.
//
// Note: the public "broadcast events" index on each game doc only contains
// first name + jersey number for goal scorers / subs — see
// _build_broadcast_events_index in post_game/pipeline.py. It DOES carry
// playerId, which is why the roster behind those ids must not be public: the
// two together would reconstitute the full names the index takes care to omit.
//
// Deploy from the Firebase console: Firestore → Rules → paste this file.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers -----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isCoach() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.role == 'coach';
    }

    // --- coach allow-list (read-only to clients; managed in console) -
    match /allowedUsers/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- viewerLog: public can append/update their own session row ---
    // The PWA writes usage pings here (app opens, section visits, video
    // watches with endTs). Keep it open (writes only, no sensitive data).
    match /viewerLog/{doc} {
      allow read: if isCoach();
      allow create, update: if true;
      allow delete: if isCoach();
    }

    // --- viewerTags: owner-assigned audience buckets ------------------
    // { email, buckets: ['coach'|'parent'|'player'|'unknown'] } written
    // from the owner-only VIEWERS page; coach-gated like analytics.
    match /viewerTags/{doc} {
      allow read, write: if isCoach();
    }

    // --- teams/main ---------------------------------------------------
    // SIGNED-IN ONLY. The roster on this doc carries every child's FULL name
    // and photo_url, and it used to be world-readable. The public pages render
    // first names only and never show a photo, and the broadcast index is
    // scrubbed to first name + jersey number — but that index also publishes
    // playerId, so anyone could pull the roster over the REST API and join it
    // straight back to the full names. The scrubbing was cosmetic; this makes
    // the data layer enforce what the app already assumes.
    //
    // Subcollection rules do NOT inherit from this one, so games/{id} and
    // games/{id}/public below stay public: the live scoreboard, the event feed
    // and the reel overlay index all keep working signed-out. Only the roster
    // lookup is lost, and the public UI falls back to the first names carried
    // in the broadcast index itself.
    match /teams/main {
      allow read: if isSignedIn();
      allow write: if isCoach();

      // --- fields/<name>: calibration presets (coach-only) -----------
      match /fields/{fieldName} {
        allow read, write: if isCoach();
      }

      // --- games/<id> ------------------------------------------------
      // Public reads the live scoreboard, events, goals, broadcast video
      // URLs + first-name-only overlay index. NO subcollections public.
      match /games/{gameId} {
        allow read: if true;
        allow write: if isCoach();

        // analytics/: full per-player + GK + identity stats. COACH-ONLY.
        match /analytics/{docId} {
          allow read, write: if isCoach();
        }

        // clips/: per-event highlight clip metadata. COACH-ONLY (the
        // public surface now uses the broadcast video URLs on the parent
        // game doc instead).
        match /clips/{clipId} {
          allow read, write: if isCoach();
        }

        // public/: PUBLIC-readable, coach-written. Holds the reel overlay
        // index (public/broadcast) moved off the game doc so the dugout /
        // scoreboard list stays lean — parents fetch it only when a reel
        // opens. Coach-only writes; anyone may read.
        match /public/{docId} {
          allow read: if true;
          allow write: if isCoach();
        }

        // any other future subcollection defaults to coach-only.
        match /{subcoll}/{subdoc} {
          allow read, write: if isCoach();
        }
      }
    }

    // --- default deny ------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

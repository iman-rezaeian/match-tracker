rules_version = '2';

// Firestore security rules for the Stompers match tracker.
//
// PRIVACY MODEL (request-access era, 2026-08)
// ───────────────────────────────────────────
// Nothing is world-readable any more. Access tiers:
//
//   Unknown signed-in user (any Google account):
//     - can create/read their OWN accessRequests/{email} doc (the "request
//       access" flow) and read their OWN allowedUsers/{email} doc (so the
//       waiting screen can flip live when the coach approves)
//     - can append viewerLog usage pings
//     - CANNOT read team, game, or player data of any kind
//
//   Allowed family member (allowedUsers/{email} exists, role == 'parent'):
//     - can READ teams/main (schedule; roster names for scoreboards),
//       games (scoreboard, events, broadcast video URLs) and the
//       public broadcast overlay index
//     - can READ teams/main/parentSeason/{playerId} ONLY for playerIds
//       listed on their own allowedUsers doc (their own kid)
//     - CANNOT read analytics/, clips/, private/, voice/ (coach-only)
//     - CANNOT write team/game data
//
//   Coach (allowedUsers role == 'coach'):
//     - full read/write under teams/main
//     - manages allowedUsers + accessRequests (approvals). Only the OWNER
//       may grant/revoke the 'coach' role itself.
//
// Pipeline service account (Admin SDK) bypasses these rules entirely.
//
// SECRETS: live-stream credentials (rtmpsUrl/streamKey) live under private/
// subdocs and raw dugout audio under games/<id>/voice/ — both coach-only.
// Never put them back on parent-readable docs.
//
// Deploy from the Firebase console: Firestore → Rules → paste this file.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers -----------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function callerEmail() {
      return request.auth.token.email.lower();
    }
    function callerDoc() {
      return get(/databases/$(database)/documents/allowedUsers/$(callerEmail())).data;
    }
    function isAllowed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(callerEmail()));
    }
    function isCoach() {
      return isAllowed() && callerDoc().role == 'coach';
    }
    // Owner = the only account allowed to mint/revoke coach rows.
    function isOwner() {
      return isSignedIn() && callerEmail() == 'rezaian.iman@gmail.com';
    }

    // --- allowedUsers: the access list --------------------------------
    // Self-get keeps the waiting screen live and lets the app learn its own
    // role/playerIds. Only coaches may list (no email harvesting).
    match /allowedUsers/{email} {
      allow get: if isCoach() || (isSignedIn() && callerEmail() == email);
      allow list: if isCoach();
      // Coaches approve parents. Writing a 'coach' row (or touching one)
      // is owner-only so a compromised coach account can't mint coaches.
      allow create, update: if (isCoach() && request.resource.data.role == 'parent'
                                 && (!exists(/databases/$(database)/documents/allowedUsers/$(email))
                                     || resource.data.role == 'parent'))
                              || isOwner();
      allow delete: if (isCoach() && resource.data.role == 'parent') || isOwner();
    }

    // --- accessRequests: the approval queue ---------------------------
    // A signed-in unknown user may file/read/withdraw exactly one request:
    // their own email. Coaches see and manage the queue.
    match /accessRequests/{email} {
      allow get: if isCoach() || (isSignedIn() && callerEmail() == email);
      allow list: if isCoach();
      allow create: if isSignedIn()
        && callerEmail() == email
        && request.resource.data.status == 'pending'
        && !('role' in request.resource.data)
        && !('playerIds' in request.resource.data);
      allow update, delete: if isCoach()
        || (isSignedIn() && callerEmail() == email);
    }

    // --- viewerLog: usage pings (signed-in only now) -------------------
    match /viewerLog/{doc} {
      allow read: if isCoach();
      allow create, update: if isSignedIn();
      allow delete: if isCoach();
    }

    // --- viewerTags: owner-assigned audience buckets ------------------
    match /viewerTags/{doc} {
      allow read, write: if isCoach();
    }

    // --- teams/main ---------------------------------------------------
    // ALLOWED FAMILIES ONLY (was: any signed-in Google account). The doc
    // carries the roster (kids' full names + inline photos) and schedule —
    // shared inside the team like any club app, invisible outside it.
    match /teams/main {
      allow read: if isAllowed();
      allow write: if isCoach();

      // --- fields/<name>: calibration presets (coach-only) -----------
      match /fields/{fieldName} {
        allow read, write: if isCoach();
      }

      // --- private/<doc>: team-level secrets (live input creds) ------
      match /private/{docId} {
        allow read, write: if isCoach();
      }

      // --- parentSeason/<playerId>: per-kid season rollup -------------
      // THE per-family data boundary: readable only by coaches and by
      // parents whose allowedUsers.playerIds contains this playerId.
      // Written by the pipeline (admin) and coach-side backfills.
      match /parentSeason/{playerId} {
        allow read: if isCoach()
          || (isAllowed() && playerId in callerDoc().get('playerIds', []));
        allow write: if isCoach();
      }

      // --- teamsnapEvents/<uid>: the synced TeamSnap calendar ---------
      // Mirrored from the team's iCal feed by the Worker cron, keyed by the
      // TeamSnap event UID. Every allowed family reads it (the calendar is the
      // parent view's schedule); NOBODY writes from a client. The cron uses a
      // service account, which bypasses these rules — so denying all client
      // writes here costs nothing and stops a signed-in parent (or a stale
      // coach build) from corrupting synced state.
      //
      // Exception to note: the coach's per-event TYPE override is a client
      // write. It is deliberately kept OUT of this collection — the sync's
      // updateMask would clobber it on the next poll — and belongs in its own
      // doc so it survives. Keep this collection feed-owned and read-only.
      match /teamsnapEvents/{eventUid} {
        allow read: if isAllowed();
        allow write: if false;
      }

      // --- calendarHidden/<id>: coach-hidden calendar entries ----------
      // TeamSnap events cannot be deleted — the feed is read-only and the cron
      // re-mirrors it every 15 minutes — so "delete" on a synced event records
      // a hide flag here instead. Deliberately NOT stored on the teamsnapEvents
      // docs, which the cron overwrites wholesale each run.
      //
      // Families read it so a hidden event disappears for them too; only a
      // coach writes it.
      match /calendarHidden/{docId} {
        allow read: if isAllowed();
        allow write: if isCoach();
      }

      // --- games/<id> ------------------------------------------------
      // Allowed families read the scoreboard, events, goals and broadcast
      // video URLs. NO subcollections readable except public/.
      match /games/{gameId} {
        allow read: if isAllowed();
        allow write: if isCoach();

        // analytics/: full per-player stats across ALL kids. COACH-ONLY.
        match /analytics/{docId} {
          allow read, write: if isCoach();
        }

        // clips/: per-event highlight clip metadata. COACH-ONLY.
        match /clips/{clipId} {
          allow read, write: if isCoach();
        }

        // public/: reel overlay index (first names + jersey numbers).
        // Readable by allowed families, written by coaches/pipeline.
        match /public/{docId} {
          allow read: if isAllowed();
          allow write: if isCoach();
        }

        // private/: per-game live-input secrets. COACH-ONLY.
        match /private/{docId} {
          allow read, write: if isCoach();
        }

        // voice/: raw dugout audio segment index. COACH-ONLY — this is
        // the coach's voice + kids' names; parents get the ambience reels.
        match /voice/{docId} {
          allow read, write: if isCoach();
        }

        // any other future subcollection defaults to coach-only.
        match /{subcoll}/{subdoc} {
          allow read, write: if isCoach();
        }
      }
    }

    // --- default deny ------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
